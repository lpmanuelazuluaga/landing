# Variables del proyecto. Copiar a .env.local para desarrollo local.
# En Vercel, cargar cada variable en su entorno (Production / Preview / Development).
# Nunca subir valores reales al repositorio. Todas pueden quedar vacías: el sitio
# compila y funciona, y cada integración queda inactiva hasta tener su valor.
#
# Las NEXT_PUBLIC_* se incrustan en el build: cambiarlas exige redeploy.

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL pública definitiva, con https:// y sin barra final (p. ej. https://lp.cliente.com).
# Sin ella no se emite canonical y el sitio nunca se indexa.
NEXT_PUBLIC_SITE_URL=

# "true" SOLO al publicar conscientemente. Además exige NEXT_PUBLIC_SITE_URL y, en
# Vercel, el entorno Production. Cualquier otro valor deja todo en noindex.
NEXT_PUBLIC_SITE_INDEXABLE=

# ── Consentimiento ───────────────────────────────────────────────────────────
# "required" (valor por defecto si queda vacío; mercados UE) o "not-required"
# (solo con validación legal del mercado del cliente).
NEXT_PUBLIC_CONSENT_MODE=

# ── Tracking: IDs públicos. Vacío = ese script no se carga ───────────────────
# Vía recomendada: solo GTM, con la plataforma de consentimiento (CMP) y el resto
# de etiquetas dentro del contenedor. Ver docs/INTEGRATIONS.md.
NEXT_PUBLIC_GTM_ID=
# Origen propio para server-side tagging (p. ej. https://sgtm.cliente.com).
# Vacío = https://www.googletagmanager.com
NEXT_PUBLIC_GTM_ORIGIN=

# Carga directa, sin GTM. Con consentimiento "required" esperan a que el
# visitante acepte en el banner integrado; nunca se cargan antes.
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Leads (solo servidor, nunca NEXT_PUBLIC_) ────────────────────────────────
# Webhook que recibe cada lead: GoHighLevel (Inbound Webhook), Make, Zapier, n8n…
# Debe ser https (http solo para localhost). Vacío = /api/leads responde 503.
LEADS_WEBHOOK_URL=
# Opcional: se envía en la cabecera x-webhook-secret para que el receptor
# descarte peticiones que no vengan de este sitio.
LEADS_WEBHOOK_SECRET=
